{
  "name": "reminder",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "reminder — calendar events and reminders (tasks) from your existing calendars, as a CLI and an MCP server. Runs on GJS via gjsify.",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "check": "gjsify foreach -A check",
    "lint": "gjsify foreach -A lint",
    "format": "gjsify workspace reminder-cli format",
    "format:check": "gjsify workspace reminder-cli format:check",
    "build": "gjsify workspace reminder-cli build",
    "start": "gjsify workspace reminder-cli start",
    "test": "gjsify workspace reminder-cli test"
  }
}
