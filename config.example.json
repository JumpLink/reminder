{
  "backend": "eds",
  "grants": [
    { "capability": "calendar.create", "target": "<calendar-uid-from-reminder-calendars>" },
    { "capability": "reminder.create", "target": "<task-list-uid-from-reminder-calendars>" },
    { "capability": "reminder.update", "target": "<task-list-uid-from-reminder-calendars>" }
  ],
  "routes": [
    { "concerns": ["invoice", "tax"], "kind": "reminder", "target": "<task-list-uid-for-paperwork>" },
    { "concerns": ["school", "kindergarten"], "kind": "event", "target": "<calendar-uid-for-family>" }
  ],
  "priorities": { "list": "<task-list-uid-for-priorities>" },
  "defaults": {
    "event": "<calendar-uid-from-reminder-calendars>",
    "reminder": "<task-list-uid-from-reminder-calendars>"
  }
}
