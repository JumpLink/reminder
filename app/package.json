{
  "name": "reminder-cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "reminder app: the `reminder` binary — CLI and MCP frontends over the @reminder/* packages, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit && gjsify run check:i18n",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run i18n:compile && gjsify build src/index.ts --app gjs --outfile dist/reminder.gjs.mjs",
    "start": "gjsify run dist/reminder.gjs.mjs",
    "dev": "gjsify run build && gjsify run start",
    "test": "gjsify run i18n:compile && DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent XDG_RUNTIME_DIR=/nonexistent gjsify test",
    "i18n:extract": "./dev/i18n.sh extract",
    "i18n:compile": "./dev/i18n.sh compile",
    "check:i18n": "node dev/check-i18n.mjs",
    "test:mcp": "node tests/integration/mcp-gjs-smoke.mjs",
    "test:eds": "bash tests/integration/eds-roundtrip.sh"
  },
  "gjsify": {
    "excludeGlobals": [
      "document",
      "navigator",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@reminder/caldav": "*",
    "@reminder/core": "*",
    "@reminder/eds": "*",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@girs/ecal-2.0": "^4.1.0",
    "@girs/edataserver-1.2": "^4.1.0",
    "@girs/gio-2.0": "^4.1.0",
    "@girs/gjs": "^4.1.0",
    "@girs/glib-2.0": "^4.1.0",
    "@girs/gobject-2.0": "^4.1.0",
    "@girs/icalglib-3.0": "^4.1.0",
    "@gjsify/cli": "0.59.0",
    "@gjsify/mcp": "0.59.0",
    "@gjsify/node-globals": "0.59.0",
    "@gjsify/rolldown-native": "0.59.0",
    "@gjsify/runtime": "0.59.0",
    "@gjsify/unit": "0.59.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.3"
  }
}
